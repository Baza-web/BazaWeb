# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.

# Postgres password (the app container builds its own DATABASE_URL from this).
POSTGRES_PASSWORD=change-me-strong-password

# Long random string used to sign staff login sessions. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Currency code shown throughout the app (ISO 4217).
CURRENCY=LKR

# Web Push (VAPID) keys for staff notifications. Generate with:
#   npx tsx -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# Leave both blank to disable push notifications (in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# First Owner account, created automatically on first boot if no staff exist yet.
# Change this password immediately after your first login.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_OWNER_NAME=Business Owner
SEED_BRANCH_NAME=Main Branch

# Optional: lets staff sign in with "Sign in with Google" instead of a
# password. Leave all three blank to hide the Google button entirely.
# See DEPLOY.md for how to create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Only needed when deploying to Vercel (or any host with no terminal access):
# a secret you make up yourself, used to trigger first-run setup by visiting
# https://yourapp.example.com/api/setup?token=<this value> once in a browser.
# Not needed for the Docker/VPS path — that seeds automatically on boot.
SETUP_TOKEN=

# A secret you make up yourself, protecting the daily reminder endpoint
# (/api/cron/reminders) from being triggered by anyone else. Needed on
# both the Docker/VPS and Vercel paths — see DEPLOY.md for the cron setup.
CRON_TOKEN=

# Only needed when deploying to Vercel: enable "Blob" storage for this
# project in the Vercel dashboard and it sets this automatically — you
# don't need to copy it yourself. Leave blank for the Docker/VPS path,
# which stores photos on local disk instead.
BLOB_READ_WRITE_TOKEN=

# Optional: lets the app email broker memo statements (an .xlsx attachment
# of what a broker currently holds). Get a free API key at resend.com.
# Leave blank to disable — memos still work, the statement just won't be
# emailed (you can still see it in the app).
RESEND_API_KEY=
# The "From" address on those emails. Using Resend's own test domain
# (onboarding@resend.dev) works without any setup, but only while your
# Resend account is in test mode. For a branded address instead, verify
# your own domain in the Resend dashboard, then set this to e.g.
# "Baza ERP <memos@yourbusiness.com>".
EMAIL_FROM=Baza ERP <onboarding@resend.dev>

# Optional: lets staff scan a receipt photo (or paste an order email's text)
# on the Accounting page and have AI fill in the amount/category/date for
# them to review before saving. Get a key at console.anthropic.com. Leave
# blank to disable — the scan button still appears but just explains it
# isn't set up yet; typing expenses in manually always works regardless.
ANTHROPIC_API_KEY=
