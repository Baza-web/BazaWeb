generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES
  ACCOUNTANT
  CRAFTSMAN
  CREATIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum ItemCategory {
  RING
  NECKLACE
  EARRING
  BRACELET
  BANGLE
  PENDANT
  LOOSE_STONE
  OTHER
}

enum ItemStatus {
  IN_STOCK
  RESERVED
  SOLD
  IN_REPAIR
  CONSIGNMENT
}

enum TaskType {
  DAILY
  SPECIAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_DUE
  NEW_MESSAGE
  LOW_STOCK
  SALE_CREATED
  SYSTEM
  LEAVE_REQUESTED
  LEAVE_DECIDED
  ATTENDANCE
  CALL_INVITE
  CUSTOMER_OCCASION
  CUSTOMER_FOLLOWUP
  REPAIR_UPDATE
  PURCHASE_ORDER_UPDATE
  MEMO_EDIT_REQUESTED
  MEMO_EDIT_DECIDED
  ORDER_ASSIGNED
  ORDER_STATUS_CHANGED
  ORDER_DELAY_REPORTED
  ORDER_APPROVAL_REQUESTED
  ORDER_APPROVAL_DECIDED
  ORDER_DEADLINE_ALERT
  WHATSAPP_ORDER_RECEIVED
}

enum LeaveType {
  SICK
  VACATION
  PERSONAL
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RepairType {
  REPAIR
  CUSTOM
}

enum RepairStatus {
  RECEIVED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  NEW_ORDER
  ORDER_CONFIRMED
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_MATERIALS
  IN_PRODUCTION
  QUALITY_CHECK
  REVISION_REQUIRED
  APPROVED
  READY_FOR_DELIVERY
  DISPATCHED
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum OrderDelayReason {
  WAITING_FOR_MATERIALS
  SUPPLIER_DELAY
  PRODUCTION_DELAY
  DESIGN_APPROVAL_PENDING
  CUSTOMER_CHANGES
  QUALITY_CONTROL_ISSUE
  STAFF_AVAILABILITY
  OTHER
}

enum OrderApprovalDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

model Branch {
  id              String   @id @default(cuid())
  name            String
  address         String?
  phone           String?
  isMain          Boolean  @default(false)
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int?
  createdAt       DateTime @default(now())

  staff          Staff[]
  inventoryItems InventoryItem[]
  customers      Customer[]
  sales          Sale[]
  expenses       Expense[]
  ledgerEntries  LedgerEntry[]
  tasks          Task[]
  attendanceLogs AttendanceLog[]
  repairOrders   RepairOrder[]
  purchaseOrders PurchaseOrder[]
  staffGroups    StaffGroup[]
  salesTargets   SalesTarget[]
  brokers        Broker[]
  brokerMemos    BrokerMemo[]
  payrollRuns    PayrollRun[]
  budgets        Budget[]
  journalEntries JournalEntry[]
  tours          Tour[]
  orders         Order[]
  supplyItems    SupplyItem[]
}

// A house brand this business trades under (e.g. "Baza Boutique", "Silver
// Boutique") — distinct from Branch, which is a physical location. One
// branch can sell for several brands; one brand can span several branches.
// Owner/Admin can add more brands as the business grows.
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  // Dispatch is blocked on this brand's orders until >=2 gold certificates
  // reach VERIFIED — configurable per brand (Maison D'or today) rather than
  // a hardcoded brand-name check, per the spec's own requirement.
  requiresGoldCertificates Boolean @default(false)
  createdAt DateTime @default(now())

  staff       Staff[]      @relation("StaffBrands")
  socialPosts SocialPost[]
  expenses    Expense[]
  sales       Sale[]
  inventoryItems InventoryItem[]
  orders      Order[]
  project     Project?
}

// Groups tasks the way Airtable groups records: every Brand automatically
// gets a matching Project (kept in sync on brand create/rename/delete, see
// applyBrandEdit and performBrandDeletion) so brand-related work has a home
// with no extra setup, and anyone who can already assign tasks can also
// create a "special project" (brandId null) for one-off work like a
// showroom opening that isn't tied to any single brand.
model Project {
  id          String   @id @default(cuid())
  name        String
  brandId     String?  @unique
  createdById String
  createdAt   DateTime @default(now())

  brand     Brand?  @relation(fields: [brandId], references: [id])
  createdBy Staff   @relation(fields: [createdById], references: [id])
  tasks     Task[]

  @@index([brandId])
}

model Staff {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  /// Extra roles beyond the primary `role` above — e.g. a Craftsman who also covers Sales.
  /// Permissions are the union of role + additionalRoles; `role` alone still drives their
  /// dashboard home and the "Manager/Sales/etc." badges shown elsewhere in the app.
  additionalRoles Role[] @default([])
  branchId     String?
  active       Boolean  @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  // HR details
  nic                    String?
  dateOfBirth            DateTime?
  address                String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  dateOfJoining          DateTime?
  employmentType         EmploymentType?
  bankName               String?
  bankAccountNumber      String?
  bankBranch             String?
  baseSalary             Float?
  documents              String[] @default([])

  branch Branch? @relation(fields: [branchId], references: [id])

  assignedTasks     Task[]            @relation("AssignedTo")
  createdTasks      Task[]            @relation("AssignedBy")
  taskComments      TaskComment[]
  sales             Sale[]
  expensesCreated   Expense[]
  sentMessages      Message[]         @relation("Sender")
  receivedMessages  Message[]         @relation("Recipient")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  customerNotes     CustomerNote[]
  leaveRequests     LeaveRequest[]   @relation("LeaveRequester")
  leaveReviews      LeaveRequest[]   @relation("LeaveReviewer")
  attendanceLogs    AttendanceLog[]
  repairOrdersAssigned RepairOrder[] @relation("RepairAssignedTo")
  repairOrdersAssignedSales RepairOrder[] @relation("RepairAssignedSales")
  repairOrdersCreated  RepairOrder[] @relation("RepairCreatedBy")
  projectsCreated      Project[]
  purchaseOrdersCreated PurchaseOrder[]
  groups            StaffGroup[]    @relation("GroupMembers")
  salesTargets      SalesTarget[]
  brokersCreated    Broker[]
  memosCreated      BrokerMemo[]            @relation("MemoCreatedBy")
  memoEditsRequested BrokerMemoEditRequest[] @relation("MemoEditRequester")
  memoEditsReviewed  BrokerMemoEditRequest[] @relation("MemoEditReviewer")
  payrollRuns        PayrollRun[]            @relation("PayrollFor")
  payrollRunsCreated PayrollRun[]            @relation("PayrollCreatedBy")
  deletionRequestsMade     DeletionRequest[] @relation("DeletionRequester")
  deletionRequestsReviewed DeletionRequest[] @relation("DeletionReviewer")
  editRequestsMade     EditRequest[] @relation("EditRequester")
  editRequestsReviewed EditRequest[] @relation("EditReviewer")
  driveConnectionsMade GoogleDriveConnection[]
  groupMessagesSent  GroupMessage[]
  socialPostsAssigned SocialPost[] @relation("SocialPostAssignee")
  socialPostsCreated  SocialPost[] @relation("SocialPostCreator")
  leaveEntitlements   LeaveEntitlement[]
  onboardingTasks     OnboardingTask[]
  brands              Brand[] @relation("StaffBrands")
  socialPostsApproved SocialPost[] @relation("SocialPostApprover")
  importBatchesMade  ImportBatch[]
  mailConnectionsMade GoogleMailConnection[]
  emailsSent          EmailLog[]
  journalEntriesMade  JournalEntry[]
  bankStatementLinesUploaded BankStatementLine[]
  voiceProfilesCreated VoiceProfile[]
  voiceGenerationsCreated VoiceGeneration[]
  customerActivitiesLogged CustomerActivity[]
  performanceReviewsReceived PerformanceReview[] @relation("ReviewSubject")
  performanceReviewsGiven    PerformanceReview[] @relation("ReviewGivenBy")
  disciplinaryRecordsReceived DisciplinaryRecord[] @relation("DisciplinarySubject")
  disciplinaryRecordsIssued   DisciplinaryRecord[] @relation("DisciplinaryIssuedBy")
  rewardTransactionsProcessed RewardTransaction[]
  toursCreated  Tour[] @relation("TourCreatedBy")
  toursApproved Tour[] @relation("TourApprovedBy")
  ordersPrimary    Order[] @relation("OrderPrimaryStaff")
  ordersSupporting Order[] @relation("OrderSupportingStaff")
  ordersCreated    Order[] @relation("OrderCreatedBy")
  orderStatusChanges   OrderStatusHistory[]
  orderDeadlineChanges OrderDeadlineChange[]
  orderDelaysReported  OrderDelay[]
  orderApprovalsRequested OrderApproval[] @relation("OrderApprovalRequester")
  orderApprovalsReviewed  OrderApproval[] @relation("OrderApprovalReviewer")
  orderComments        OrderComment[]
  qcInspectionsPerformed QCInspection[]
  goldCertificatesVerified GoldCertificate[]
  handoversFrom OrderHandover[] @relation("HandoverFrom")
  handoversTo   OrderHandover[] @relation("HandoverTo")
  toolsAssigned WorkshopTool[]
  toolMaintenanceLogged ToolMaintenanceLog[]
  suppliesIssued SupplyIssue[]
  qrCodesCreated QRCode[]
  whatsappOrdersReviewed WhatsAppInboundOrder[]

  @@index([branchId])
}

enum PerformanceRating {
  NEEDS_IMPROVEMENT
  MEETS_EXPECTATIONS
  EXCEEDS_EXPECTATIONS
  OUTSTANDING
}

model PerformanceReview {
  id                  String            @id @default(cuid())
  staffId             String
  reviewerId          String
  periodLabel         String
  rating              PerformanceRating
  strengths           String?
  areasForImprovement String?
  goals               String?
  createdAt           DateTime          @default(now())

  staff    Staff @relation("ReviewSubject", fields: [staffId], references: [id])
  reviewer Staff @relation("ReviewGivenBy", fields: [reviewerId], references: [id])

  @@index([staffId])
}

enum DisciplinarySeverity {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
}

model DisciplinaryRecord {
  id          String               @id @default(cuid())
  staffId     String
  issuedById  String
  severity    DisciplinarySeverity
  description String
  actionTaken String?
  occurredAt  DateTime
  createdAt   DateTime             @default(now())

  staff    Staff @relation("DisciplinarySubject", fields: [staffId], references: [id])
  issuedBy Staff @relation("DisciplinaryIssuedBy", fields: [issuedById], references: [id])

  @@index([staffId])
}

model InventoryItem {
  id             String       @id @default(cuid())
  sku            String       @unique
  name           String
  category       ItemCategory
  metalType      String?
  metalPurity    String?
  grossWeightG   Float?
  netWeightG     Float?
  gemstoneType   String?
  caratWeight    Float?
  clarity        String?
  cut            String?
  certification  String?
  costPrice      Float
  sellingPrice   Float
  images         String[]     @default([])
  documents      String[]     @default([])
  driveLink      String?
  status         ItemStatus   @default(IN_STOCK)
  quantity       Int          @default(1)
  lowStockAt     Int          @default(1)
  notes          String?
  branchId       String
  brandId        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id])
  brand        Brand?        @relation(fields: [brandId], references: [id])
  saleItems    SaleItem[]
  repairOrders RepairOrder[]
  brokerMemoItems BrokerMemoItem[]

  @@index([branchId])
  @@index([status])
  @@index([brandId])
}

enum InventoryAttributeKind {
  GEMSTONE_TYPE
  CLARITY
  CUT
  CERTIFICATION
}

/// A locked-but-extensible vocabulary for the 4 Inventory fields a non-technical shop
/// owner would otherwise type as free text (gemstone type, clarity, cut, certification) —
/// anyone entering a "Natural Sapphire" and a "Purple Sapphire Unheated Tanzania" as two
/// different gemstoneType strings fragments the Reports/Dashboard breakdown that groups by
/// that field. Locking it to a picklist (still addable — see addInventoryAttributeOption)
/// keeps the canonical name ("Sapphire") in gemstoneType and the descriptive detail in the
/// item's own name field, so "how many sapphires do we have" rolls up correctly.
model InventoryAttributeOption {
  id        String                 @id @default(cuid())
  kind      InventoryAttributeKind
  name      String
  active    Boolean                @default(true)
  createdAt DateTime               @default(now())

  @@unique([kind, name])
  @@index([kind])
}

enum CustomerStage {
  LEAD
  PROSPECT
  CUSTOMER
}

enum CustomerActivityType {
  CALL
  VISIT
  STAGE_CHANGE
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  birthday  DateTime?
  anniversary DateTime?
  tags      String[] @default([])
  stage     CustomerStage @default(CUSTOMER)
  rewardBalance Float @default(0)
  branchId  String
  createdAt DateTime @default(now())

  branch       Branch             @relation(fields: [branchId], references: [id])
  sales        Sale[]
  notes        CustomerNote[]
  repairOrders RepairOrder[]
  emails       EmailLog[]
  activities   CustomerActivity[]
  rewardTransactions RewardTransaction[]
  orders       Order[]

  @@index([branchId])
}

model CustomerNote {
  id           String   @id @default(cuid())
  customerId   String
  staffId      String
  body         String
  followUpAt   DateTime?
  followUpDone Boolean  @default(false)
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])

  @@index([customerId])
}

// The parts of a customer's activity timeline that don't already have a home
// elsewhere (sales, repairs, emails, and CustomerNote all carry their own
// timestamp and feed into the same merged timeline — see src/lib/customerTimeline.ts).
model CustomerActivity {
  id         String               @id @default(cuid())
  customerId String
  type       CustomerActivityType
  note       String
  staffId    String
  occurredAt DateTime             @default(now())
  createdAt  DateTime             @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])

  @@index([customerId])
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String?
  branchId      String
  brandId       String?
  staffId       String
  subtotal      Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float
  amountPaid    Float         @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())

  branch   Branch     @relation(fields: [branchId], references: [id])
  brand    Brand?     @relation(fields: [brandId], references: [id])
  staff    Staff      @relation(fields: [staffId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  ledgerEntry LedgerEntry?
  journalEntry JournalEntry?
  rewardTransactions RewardTransaction[]
  orders       Order[]
  whatsappOrder WhatsAppInboundOrder?

  @@index([branchId])
  @@index([brandId])
  @@index([customerId])
}

// Singleton row (fixed id "default") holding the loyalty program's current
// earn rate — see src/lib/rewards.ts's getRewardSettings, which creates it
// on first read. Owner/Admin only; a business policy, not a deploy-time config.
model RewardProgramSettings {
  id            String   @id @default("default")
  rewardPer100k Float    @default(1000) // LKR rewarded per 100,000 LKR spent
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

enum RewardTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
}

model RewardTransaction {
  id          String                @id @default(cuid())
  customerId  String
  type        RewardTransactionType
  amount      Float
  saleId      String?
  note        String?
  createdById String?
  createdAt   DateTime              @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  sale      Sale?    @relation(fields: [saleId], references: [id])
  createdBy Staff?   @relation(fields: [createdById], references: [id])

  @@index([customerId])
  @@index([saleId])
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  inventoryItemId String
  quantity        Int     @default(1)
  priceEach       Float

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([saleId])
}

model Expense {
  id          String   @id @default(cuid())
  branchId    String
  brandId     String?
  category    String
  description String
  amount      Float
  date        DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())
  receiptImage String?

  purchaseOrderId String?

  branch        Branch         @relation(fields: [branchId], references: [id])
  brand         Brand?         @relation(fields: [brandId], references: [id])
  createdBy     Staff          @relation(fields: [createdById], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  ledgerEntry   LedgerEntry?
  journalEntry  JournalEntry?

  @@index([branchId])
  @@index([brandId])
  @@index([purchaseOrderId])
}

// A monthly spending cap per expense category, so Accounting can flag
// overspend and point at exactly where to cut cost.
model Budget {
  id           String   @id @default(cuid())
  branchId     String
  category     String
  monthlyLimit Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, category])
}

model LedgerEntry {
  id          String     @id @default(cuid())
  branchId    String
  type        LedgerType
  amount      Float
  description String
  date        DateTime   @default(now())
  saleId      String?    @unique
  expenseId   String?    @unique
  createdAt   DateTime   @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id])
  sale    Sale?    @relation(fields: [saleId], references: [id])
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@index([branchId, date])
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  type         TaskType     @default(DAILY)
  priority     TaskPriority @default(NORMAL)
  status       TaskStatus   @default(PENDING)
  dueDate      DateTime?
  branchId     String
  assignedToId String
  assignedById String
  groupId      String?
  orderId      String?
  projectId    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  completedAt  DateTime?

  branch     Branch        @relation(fields: [branchId], references: [id])
  assignedTo Staff         @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedBy Staff         @relation("AssignedBy", fields: [assignedById], references: [id])
  group      StaffGroup?   @relation(fields: [groupId], references: [id])
  order      Order?        @relation(fields: [orderId], references: [id])
  project    Project?      @relation(fields: [projectId], references: [id])
  comments   TaskComment[]

  @@index([branchId])
  @@index([assignedToId])
  @@index([groupId])
  @@index([orderId])
  @@index([projectId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  staffId   String
  body      String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@index([taskId])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    Staff @relation("Sender", fields: [senderId], references: [id])
  recipient Staff @relation("Recipient", fields: [recipientId], references: [id])

  @@index([recipientId, readAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(cuid())
  staffId   String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  staffId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  staffId      String
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())

  staff      Staff  @relation("LeaveRequester", fields: [staffId], references: [id])
  reviewedBy Staff? @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([staffId])
}

// How many days of each leave type a staff member gets in a given year —
// set once by an Owner/Admin/Manager; balance is this minus approved requests.
model LeaveEntitlement {
  id           String    @id @default(cuid())
  staffId      String
  type         LeaveType
  year         Int
  daysAllotted Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, type, year])
}

// A simple new-hire checklist seeded automatically when a staff account is
// created — nothing fancier than a fixed list of common onboarding steps.
model OnboardingTask {
  id          String    @id @default(cuid())
  staffId     String
  label       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model AttendanceLog {
  id          String    @id @default(cuid())
  staffId     String
  branchId    String
  clockInAt   DateTime  @default(now())
  clockOutAt  DateTime?
  clockInLat  Float?
  clockInLng  Float?
  clockOutLat Float?
  clockOutLng Float?

  staff  Staff  @relation(fields: [staffId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([staffId])
  @@index([branchId, clockInAt])
}

model RepairOrder {
  id                  String       @id @default(cuid())
  customerId          String
  branchId            String
  type                RepairType   @default(REPAIR)
  description         String
  intakeDate          DateTime     @default(now())
  promisedDate        DateTime?
  status              RepairStatus @default(RECEIVED)
  estimatedCost       Float?
  finalCost           Float?
  relatedInventoryItemId String?
  assignedToId        String?
  // The Sales staff who handled this customer stays attached to the order alongside the
  // Craftsman doing the work — both stay jointly accountable until the customer's follow-up
  // (e.g. a Google review) closes the loop, not just whoever did the intake.
  assignedSalesId     String?
  createdById         String
  photos              String[]     @default([])
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  completedAt         DateTime?

  customer            Customer       @relation(fields: [customerId], references: [id])
  branch               Branch        @relation(fields: [branchId], references: [id])
  relatedInventoryItem InventoryItem? @relation(fields: [relatedInventoryItemId], references: [id])
  assignedTo           Staff?         @relation("RepairAssignedTo", fields: [assignedToId], references: [id])
  assignedSales        Staff?         @relation("RepairAssignedSales", fields: [assignedSalesId], references: [id])
  createdBy            Staff          @relation("RepairCreatedBy", fields: [createdById], references: [id])

  @@index([branchId])
  @@index([customerId])
  @@index([assignedToId])
  @@index([assignedSalesId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contactName String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  gemstoneSpecs  OrderGemstoneSpec[]
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  orderNumber   String              @unique
  supplierId    String
  branchId      String
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  totalAmount   Float               @default(0)
  amountPaid    Float               @default(0)
  notes         String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  branch    Branch              @relation(fields: [branchId], references: [id])
  createdBy Staff               @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
  expenses  Expense[]

  @@index([branchId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  description     String
  quantity        Int           @default(1)
  unitCost        Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model StaffGroup {
  id             String   @id @default(cuid())
  name           String
  branchId       String
  isCreativeTeam Boolean  @default(false)
  createdAt      DateTime @default(now())

  branch      Branch       @relation(fields: [branchId], references: [id])
  members     Staff[]      @relation("GroupMembers")
  tasks       Task[]
  messages    GroupMessage[]
  socialPosts SocialPost[]

  @@index([branchId])
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP_STATUS
  OTHER
}

enum ContentStatus {
  IDEA
  DRAFTING
  READY
  SCHEDULED
  POSTED
}

// A planned social-media post for a creative team: what/when/for which
// platform. Publishing itself stays manual (posted from the real
// Instagram/TikTok app) — this is the planning board, not a bot.
model SocialPost {
  id           String         @id @default(cuid())
  groupId      String
  brandId      String
  platform     SocialPlatform @default(INSTAGRAM)
  title        String
  caption      String?
  notes        String?
  images       String[]       @default([])
  scheduledAt  DateTime?
  status       ContentStatus  @default(IDEA)
  assignedToId String?
  createdById  String
  postedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Instagram auto-publish: a Creative can request it, but an Owner/Admin
  // must approve before the scheduled publish job will actually post it.
  autoPublish            Boolean   @default(false)
  approvedById           String?
  approvedAt             DateTime?
  publishedToInstagramAt DateTime?
  instagramMediaId       String?
  publishError           String?

  group      StaffGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  brand      Brand      @relation(fields: [brandId], references: [id])
  assignedTo Staff?     @relation("SocialPostAssignee", fields: [assignedToId], references: [id])
  createdBy  Staff      @relation("SocialPostCreator", fields: [createdById], references: [id])
  approvedBy Staff?     @relation("SocialPostApprover", fields: [approvedById], references: [id])

  @@index([groupId, scheduledAt])
  @@index([brandId])
}

// Simple in-app group chat scoped to a Staff Group (e.g. the Creatives team) —
// a shared channel any member can post in, separate from 1:1 Messages.
model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  group  StaffGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender Staff      @relation(fields: [senderId], references: [id])

  @@index([groupId, createdAt])
}

model SalesTarget {
  id           String   @id @default(cuid())
  staffId      String
  branchId     String
  periodStart  DateTime
  periodEnd    DateTime
  targetAmount Float
  createdAt    DateTime @default(now())

  staff  Staff  @relation(fields: [staffId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([staffId])
  @@index([branchId])
}

enum MemoStatus {
  OPEN
  PARTIALLY_RETURNED
  RETURNED
}

enum MemoEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Broker {
  id          String   @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  active      Boolean  @default(true)
  branchId    String
  createdById String
  createdAt   DateTime @default(now())

  branch    Branch       @relation(fields: [branchId], references: [id])
  createdBy Staff        @relation(fields: [createdById], references: [id])
  memos     BrokerMemo[]

  @@index([branchId])
}

model BrokerMemo {
  id               String     @id @default(cuid())
  memoNumber       String     @unique
  brokerId         String
  branchId         String
  status           MemoStatus @default(OPEN)
  issuedAt         DateTime   @default(now())
  expectedReturnAt DateTime?
  notes            String?
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  broker       Broker                  @relation(fields: [brokerId], references: [id])
  branch       Branch                  @relation(fields: [branchId], references: [id])
  createdBy    Staff                   @relation("MemoCreatedBy", fields: [createdById], references: [id])
  items        BrokerMemoItem[]
  editRequests BrokerMemoEditRequest[]

  @@index([brokerId])
  @@index([branchId])
}

model BrokerMemoItem {
  id               String @id @default(cuid())
  memoId           String
  inventoryItemId  String
  quantity         Int    @default(1)
  returnedQuantity Int    @default(0)
  valueEach        Float

  memo          BrokerMemo    @relation(fields: [memoId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([memoId])
}

// Maker-checker control: a change to an already-created memo (recording a
// return, editing notes) is proposed here and only takes effect once a
// different Owner/Admin approves it — the requester can never approve
// their own request. itemReturns is a JSON array of
// { memoItemId, returnQuantity }.
model BrokerMemoEditRequest {
  id            String                 @id @default(cuid())
  memoId        String
  status        MemoEditRequestStatus  @default(PENDING)
  itemReturns   Json
  notesChange   String?
  reason        String?
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime               @default(now())

  memo        BrokerMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)
  requestedBy Staff      @relation("MemoEditRequester", fields: [requestedById], references: [id])
  reviewedBy  Staff?     @relation("MemoEditReviewer", fields: [reviewedById], references: [id])

  @@index([memoId])
}

enum PayrollStatus {
  DRAFT
  PAID
}

// One staff member's pay for one period. Attendance/leave figures are a
// snapshot captured at creation time for the Accountant to review, not a
// live link — editing past attendance later never silently changes a
// payroll record that's already been drafted or paid.
model PayrollRun {
  id             String        @id @default(cuid())
  staffId        String
  branchId       String
  periodStart    DateTime
  periodEnd      DateTime
  baseSalary     Float
  daysPresent    Int
  leaveDaysTaken Int
  adjustment     Float         @default(0)
  adjustmentNote String?
  netPay         Float
  status         PayrollStatus @default(DRAFT)
  paidAt         DateTime?
  expenseId      String?       @unique
  createdById    String
  createdAt      DateTime      @default(now())

  staff     Staff  @relation("PayrollFor", fields: [staffId], references: [id])
  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy Staff  @relation("PayrollCreatedBy", fields: [createdById], references: [id])

  @@index([staffId])
  @@index([branchId, periodStart])
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Maker-checker control for permanently deleting a record: Admin can only
// request it, a different Owner must approve before anything is actually
// deleted. entityLabel keeps a human-readable snapshot so the request is
// still legible even after the underlying record is gone.
model DeletionRequest {
  id            String                 @id @default(cuid())
  entityType    String
  entityId      String
  entityLabel   String
  reason        String?
  status        DeletionRequestStatus  @default(PENDING)
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime               @default(now())

  requestedBy Staff  @relation("DeletionRequester", fields: [requestedById], references: [id])
  reviewedBy  Staff? @relation("DeletionReviewer", fields: [reviewedById], references: [id])

  @@index([entityType, entityId])
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Maker-checker control for editing a record: anyone but the Owner can only
// request a change, a different Owner must approve before it actually takes
// effect. proposedData is the exact field->value payload to apply on
// approval; fieldSummary is a short human-readable description of the
// change, so the Owner can review it without needing to know the schema.
model EditRequest {
  id            String            @id @default(cuid())
  entityType    String
  entityId      String
  entityLabel   String
  fieldSummary  String
  proposedData  Json
  reason        String?
  status        EditRequestStatus @default(PENDING)
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())

  requestedBy Staff  @relation("EditRequester", fields: [requestedById], references: [id])
  reviewedBy  Staff? @relation("EditReviewer", fields: [reviewedById], references: [id])

  @@index([entityType, entityId])
}

// A single shared connection to one Google account's Drive, used for the
// daily backup and (later) Sheets sync — not a per-staff login. Always
// upserted at id "singleton" so there is at most one row.
model GoogleDriveConnection {
  id                     String   @id @default("singleton")
  encryptedRefreshToken  String
  googleEmail            String
  driveFolderId          String?
  connectedByStaffId     String
  connectedAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt

  connectedBy Staff @relation(fields: [connectedByStaffId], references: [id])
}

// Holds a parsed, already-diffed Excel upload between the "preview" and
// "apply" steps of bulk import, so the browser doesn't have to re-upload
// or hold the whole workbook in a form field — see src/lib/xlsxImport.ts.
// Owner-only for now: applying a batch always takes effect immediately,
// the same as any other direct Owner edit, so there's no approval status
// here the way EditRequest has one.
model ImportBatch {
  id          String   @id @default(cuid())
  entityType  String
  createdById String
  rowsJson    Json
  createdAt   DateTime @default(now())

  createdBy Staff @relation(fields: [createdById], references: [id])
}

// A single shared connection to one Google account's Gmail, used to send
// client emails as that real address (gmail.send scope only — this app
// never reads the mailbox). Same singleton pattern as GoogleDriveConnection;
// deliberately a separate connection/scope/redirect URI so Drive and Gmail
// access can be granted, revoked, or re-authorized independently.
model GoogleMailConnection {
  id                    String   @id @default("singleton")
  encryptedRefreshToken String
  googleEmail           String
  connectedByStaffId    String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  connectedBy Staff @relation(fields: [connectedByStaffId], references: [id])
}

// One email sent to a customer through the connected Gmail account —
// kept so staff can see what's already been said to a customer, not just
// that an email button exists. Not a full inbox: outbound only.
model EmailLog {
  id          String   @id @default(cuid())
  customerId  String
  toEmail     String
  subject     String
  body        String
  sentById    String
  gmailMsgId  String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  sentBy   Staff    @relation(fields: [sentById], references: [id])

  @@index([customerId])
}

// --- Double-entry accounting (Chart of Accounts / General Ledger) ---
// This is a new, parallel ledger — separate from LedgerEntry (the
// existing Sale/Expense/Payroll income-expense log). Nothing here
// changes how Sale/Expense/Payroll are created or displayed; it's an
// independent foundation for real double-entry bookkeeping, built so
// it can later be wired to post automatically from those flows without
// touching their own code paths.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  // Seeded defaults (see src/lib/ledger.ts DEFAULT_ACCOUNTS) are protected
  // from deletion; a user-created account can be removed if unused.
  isSystem  Boolean     @default(true)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  journalLines JournalLine[]
  bankStatementLines BankStatementLine[]
}

// One posted, balanced double-entry transaction. Never deleted once
// posted — see reversalOfId: corrections happen via a new entry that
// flips the original's debits/credits, not by editing or removing this
// row (see "ACCOUNTING SECURITY" in the project's operating notes:
// reversal entries only, never silent deletes).
model JournalEntry {
  id           String    @id @default(cuid())
  entryNumber  String    @unique
  date         DateTime  @default(now())
  description  String
  reference    String?
  branchId     String?
  department   String?
  createdById  String
  createdAt    DateTime  @default(now())
  reversalOfId String?   @unique
  // Links the live entry to the Sale/Expense it was auto-posted for, so it
  // can be found again to reverse or repost. Cleared (never cascade-deleted)
  // if the Sale/Expense itself is deleted — the entry is a permanent record.
  saleId       String?   @unique
  expenseId    String?   @unique

  lines       JournalLine[]
  branch      Branch?       @relation(fields: [branchId], references: [id])
  createdBy   Staff         @relation(fields: [createdById], references: [id])
  reversalOf  JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy  JournalEntry? @relation("Reversal")
  sale        Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  expense     Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([branchId])
}

model JournalLine {
  id             String @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float  @default(0)
  credit         Float  @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  matchedBankLine BankStatementLine?

  @@index([accountId])
  @@index([journalEntryId])
}

// One row from an uploaded bank statement (CSV/Excel) for a Cash/Bank
// account. Matched against an existing posted JournalLine on that same
// account to confirm the books agree with the bank — reconciliation never
// creates or edits a journal entry itself, only links to one that's
// already posted.
model BankStatementLine {
  id            String   @id @default(cuid())
  accountId     String
  date          DateTime
  description   String
  // Signed from the bank's own point of view: positive = money in, negative = money out.
  amount        Float
  reconciled    Boolean  @default(false)
  matchedJournalLineId String? @unique
  uploadedById  String
  createdAt     DateTime @default(now())

  account            Account      @relation(fields: [accountId], references: [id])
  matchedJournalLine JournalLine? @relation(fields: [matchedJournalLineId], references: [id])
  uploadedBy         Staff        @relation(fields: [uploadedById], references: [id])

  @@index([accountId])
  @@index([reconciled])
}

// A voice cloned (with the speaker's consent) via ElevenLabs — consentNote
// records who confirmed consent and when, since this clones a real
// person's voice likeness. Never delete a Staff row just because a
// VoiceProfile references it; see src/lib/deletion.ts's anonymization
// pattern for Staff.
model VoiceProfile {
  id                String   @id @default(cuid())
  name              String
  elevenLabsVoiceId String   @unique
  consentNote       String
  createdById       String
  createdAt         DateTime @default(now())

  createdBy   Staff             @relation(fields: [createdById], references: [id])
  generations VoiceGeneration[]
}

model VoiceGeneration {
  id             String   @id @default(cuid())
  voiceProfileId String
  text           String
  audioUrl       String
  createdById    String
  createdAt      DateTime @default(now())

  voiceProfile VoiceProfile @relation(fields: [voiceProfileId], references: [id])
  createdBy    Staff        @relation(fields: [createdById], references: [id])

  @@index([voiceProfileId])
}

// ── Travel & Experiences (Phase 1: internal tour management only) ──────────
// Booking/GetYourGuide/finance integration is Phase 2+; this models a tour
// as a standalone internal product so it works before any marketplace is
// wired in. See DEPLOY.md and the Travel dashboard for current scope.

enum TourStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  READY_FOR_MARKETPLACE
  PUBLISHED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TourType {
  PRIVATE
  GROUP
}

model Tour {
  id                 String     @id @default(cuid())
  internalCode       String     @unique
  title              String
  category           String
  destination        String?
  country            String?
  city               String?
  durationMinutes    Int?
  description        String?
  highlights         String?
  includedItems      String?
  excludedItems      String?
  languages          String[]   @default([])
  tourType           TourType   @default(GROUP)
  minParticipants    Int?
  maxParticipants    Int?
  meetingPoint       String?
  pickupInfo         String?
  cancellationPolicy String?
  importantInfo      String?
  images             String[]   @default([])
  priceAdult         Float?
  priceChild         Float?
  currency           String     @default("LKR")
  operatingDays      String[]   @default([])
  startingTimes      String[]   @default([])
  status             TourStatus @default(DRAFT)
  branchId           String?
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  internalNotes      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  archivedAt         DateTime?

  branch     Branch? @relation(fields: [branchId], references: [id])
  createdBy  Staff   @relation("TourCreatedBy", fields: [createdById], references: [id])
  approvedBy Staff?  @relation("TourApprovedBy", fields: [approvedById], references: [id])

  @@index([branchId])
  @@index([status])
}

// ── Orders Handling ──────────────────────────────────────────────────────
// A standalone order-fulfillment/production-tracking model, separate from
// both Sale (point-of-sale invoicing) and RepairOrder (repair/custom-piece
// intake) — this is for tracking the end-to-end production of any business
// order (custom jewelry, bespoke commissions, etc.) across multiple staff,
// departments and a deadline lifecycle. `department` is free text (like
// Tour.category) rather than its own model — there's no existing department
// concept anywhere else in this ERP to reuse, and a full org-chart entity
// isn't needed yet. currentDeadline is indexed so "overdue"/"due soon"
// buckets can be computed with plain date-range WHERE clauses (see
// src/lib/orderPriority.ts) instead of a stored, staleness-prone status.
model Order {
  id                         String        @id @default(cuid())
  orderNumber                String        @unique
  brandId                    String?
  customerId                 String?
  customerContact            String?
  orderType                  String
  productOrService           String
  description                String?
  specifications             String?
  customizationRequirements  String?
  quantity                   Int?          @default(1)
  orderValue                 Float?
  department                 String?
  orderDate                  DateTime      @default(now())
  originalDeadline           DateTime
  currentDeadline            DateTime
  manualPriority             TaskPriority?
  status                     OrderStatus   @default(NEW_ORDER)
  progressPercent            Int           @default(0)
  internalInstructions       String?
  customerInstructions       String?
  referenceImages            String[]      @default([])
  supportingDocuments        String[]      @default([])
  branchId                   String?
  primaryStaffId             String
  createdById                String
  relatedSaleId              String?
  completedAt                DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  brand           Brand?    @relation(fields: [brandId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  branch          Branch?   @relation(fields: [branchId], references: [id])
  primaryStaff    Staff     @relation("OrderPrimaryStaff", fields: [primaryStaffId], references: [id])
  createdBy       Staff     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  relatedSale     Sale?     @relation(fields: [relatedSaleId], references: [id])
  supportingStaff Staff[]   @relation("OrderSupportingStaff")

  statusHistory   OrderStatusHistory[]
  deadlineHistory OrderDeadlineChange[]
  delays          OrderDelay[]
  approvals       OrderApproval[]
  comments        OrderComment[]
  tasks           Task[]
  metalSpecs       OrderMetalSpec[]
  gemstoneSpecs    OrderGemstoneSpec[]
  components       OrderComponent[]
  qcInspections    QCInspection[]
  goldCertificates GoldCertificate[]
  handovers        OrderHandover[]
  supplyIssues     SupplyIssue[]
  whatsappOrder    WhatsAppInboundOrder?

  @@index([branchId])
  @@index([brandId])
  @@index([primaryStaffId])
  @@index([status])
  @@index([currentDeadline])
}

// --- Production, QC & Maison D'or compliance (Phase 3) ---
//
// Deliberately layered onto the existing Order lifecycle (same status enum,
// same primaryStaff/supportingStaff assignment, same statusHistory) rather
// than forking a parallel production-order system — Orders Handling already
// has IN_PRODUCTION/QUALITY_CHECK/REVISION_REQUIRED/APPROVED states; what was
// missing was structured data capture for those stages, not new workflow
// plumbing.

enum MetalType {
  GOLD
  SILVER
  PALLADIUM
  OTHER
}

// One row per metal used on an order — estimated at BOM time, actual
// filled in once production reports real consumption/wastage/scrap.
model OrderMetalSpec {
  id                   String    @id @default(cuid())
  orderId              String
  metalType            MetalType
  purity               String?
  estimatedWeightGrams Float?
  actualWeightGrams    Float?
  wastageGrams         Float?
  scrapRecoveredGrams  Float?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Per-stone record — deliberately one row per physical stone, not a
// quantity field, since each gemstone's certificate/treatment/origin is
// individual. Unverified fields must be entered as unknown, never guessed.
model OrderGemstoneSpec {
  id                String    @id @default(cuid())
  orderId           String
  gemstoneType      String
  caratWeight       Float?
  dimensions        String?
  cut               String?
  color             String?
  clarity           String?
  origin            String?
  treatment         String?
  certificateNumber String?
  certificateDocUrl String?
  supplierId        String?
  photos            String[]  @default([])
  verified          Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([orderId])
  @@index([supplierId])
}

// Findings, packaging and other non-metal/non-gemstone BOM lines.
model OrderComponent {
  id           String   @id @default(cuid())
  orderId      String
  name         String
  estimatedQty Int?
  actualQty    Int?
  unit         String?
  notes        String?
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum QCDecision {
  PASS
  FAIL
  NA
}

// Owner/Admin-configurable checklist items, so QC criteria can change
// without a code deploy — satisfies "configurable, not hardcoded."
model QCChecklistTemplate {
  id        String   @id @default(cuid())
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  results QCChecklistResult[]
}

// One inspection attempt. Multiple inspections per order are expected —
// a FAIL returns the order to rework and a fresh inspection follows;
// every past inspection is preserved, never overwritten.
model QCInspection {
  id           String     @id @default(cuid())
  orderId      String
  inspectorId  String
  decision     QCDecision
  generalNotes String?
  performedAt  DateTime   @default(now())

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspector Staff               @relation(fields: [inspectorId], references: [id])
  results   QCChecklistResult[]

  @@index([orderId])
  @@index([inspectorId])
}

model QCChecklistResult {
  id           String     @id @default(cuid())
  inspectionId String
  templateId   String?
  label        String
  result       QCDecision
  comment      String?
  photoUrl     String?

  inspection QCInspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  template   QCChecklistTemplate? @relation(fields: [templateId], references: [id])

  @@index([inspectionId])
}

enum CertificateVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

// Gold certificate tracking for brands flagged `requiresGoldCertificates`
// (Maison D'or today, configurable to any brand) — dispatch is blocked
// unless at least 2 certificates on the order reach VERIFIED.
model GoldCertificate {
  id                 String                         @id @default(cuid())
  orderId            String
  certificateNumber  String
  issuingAuthority   String?
  documentUrl        String?
  goldSpecification  String?
  verificationStatus CertificateVerificationStatus  @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?
  notes              String?
  createdAt          DateTime                       @default(now())

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy Staff? @relation(fields: [verifiedById], references: [id])

  @@index([orderId])
}

// Explicit staff-to-staff work handover, distinct from OrderStatusHistory
// (which records status transitions, not who-to-whom the physical work
// moved) — spec 11.6 asks for both employees, materials and acknowledgement.
model OrderHandover {
  id             String    @id @default(cuid())
  orderId        String
  fromStaffId    String?
  toStaffId      String
  handoverAt     DateTime  @default(now())
  materialsNote  String?
  photos         String[]  @default([])
  acknowledgedAt DateTime?

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStaff Staff? @relation("HandoverFrom", fields: [fromStaffId], references: [id])
  toStaff   Staff  @relation("HandoverTo", fields: [toStaffId], references: [id])

  @@index([orderId])
}

enum ToolCondition {
  GOOD
  DAMAGED
  MISSING
  UNDER_MAINTENANCE
}

// Reusable workshop tools have a checkout/return lifecycle, unlike
// consumable supplies — kept as its own model rather than overloading
// InventoryItem's sale-oriented quantity/status semantics.
model WorkshopTool {
  id                 String        @id @default(cuid())
  toolId             String        @unique
  name               String
  assignedStaffId    String?
  issueDate          DateTime?
  expectedReturnDate DateTime?
  returnDate         DateTime?
  condition          ToolCondition @default(GOOD)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  assignedStaff   Staff?               @relation(fields: [assignedStaffId], references: [id])
  maintenanceLogs ToolMaintenanceLog[]

  @@index([assignedStaffId])
}

model ToolMaintenanceLog {
  id         String   @id @default(cuid())
  toolId     String
  loggedById String
  date       DateTime @default(now())
  note       String
  cost       Float?
  createdAt  DateTime @default(now())

  tool     WorkshopTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  loggedBy Staff        @relation(fields: [loggedById], references: [id])

  @@index([toolId])
}

enum SupplyCategory {
  OFFICE_SUPPLY
  JEWELLERY_BOX
  PACKAGING
  CONSUMABLE
}

// Deliberately NOT folded into InventoryItem: that model's cost/sell-price
// and sale-driven decrement semantics don't fit non-sellable consumables,
// and spec rule #7 ("don't create duplicate inventory systems") is honored
// by giving this its own narrow model rather than a second full catalog.
model SupplyItem {
  id              String         @id @default(cuid())
  sku             String         @unique
  name            String
  category        SupplyCategory
  unit            String?
  quantity        Int            @default(0)
  minimumStock    Int            @default(0)
  purchasePrice   Float?
  storageLocation String?
  branchId        String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  branch Branch?       @relation(fields: [branchId], references: [id])
  issues SupplyIssue[]

  @@index([branchId])
  @@index([category])
}

model SupplyIssue {
  id              String   @id @default(cuid())
  supplyItemId    String
  quantity        Int
  issuedToStaffId String?
  orderId         String?
  reason          String?
  issuedAt        DateTime @default(now())

  supplyItem    SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)
  issuedToStaff Staff?     @relation(fields: [issuedToStaffId], references: [id])
  order         Order?     @relation(fields: [orderId], references: [id])

  @@index([supplyItemId])
  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?
  changedById String
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy Staff @relation(fields: [changedById], references: [id])

  @@index([orderId])
}

// Every deadline change is additive — previousDeadline/newDeadline on each
// row preserves full history; Order.originalDeadline never changes once set.
model OrderDeadlineChange {
  id               String   @id @default(cuid())
  orderId          String
  previousDeadline DateTime
  newDeadline      DateTime
  reason           String
  changedById      String
  createdAt        DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy Staff @relation(fields: [changedById], references: [id])

  @@index([orderId])
}

model OrderDelay {
  id           String            @id @default(cuid())
  orderId      String
  reasonType   OrderDelayReason
  explanation  String
  reportedById String
  createdAt    DateTime          @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportedBy Staff @relation(fields: [reportedById], references: [id])

  @@index([orderId])
}

model OrderApproval {
  id            String                  @id @default(cuid())
  orderId       String
  decision      OrderApprovalDecision?
  comments      String?
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                @default(now())

  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy Staff  @relation("OrderApprovalRequester", fields: [requestedById], references: [id])
  reviewedBy  Staff? @relation("OrderApprovalReviewer", fields: [reviewedById], references: [id])

  @@index([orderId])
}

model OrderComment {
  id        String   @id @default(cuid())
  orderId   String
  staffId   String
  body      String
  photos    String[] @default([])
  documents String[] @default([])
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@index([orderId])
}

// Owner/Admin-configurable urgency thresholds — a singleton row, same
// pattern as GoogleDriveConnection. Defaults match the spec exactly.
model OrderPrioritySettings {
  id            String   @id @default("singleton")
  criticalHours Int      @default(24)
  highHours     Int      @default(48)
  mediumDays    Int      @default(5)
  updatedAt     DateTime @updatedAt
}

// Owner/Admin-configurable sidebar order — a singleton row storing the
// NAV array's `href` values in the order every user should see them.
// Applies company-wide, not per-user. Hrefs not listed here (a nav entry
// added after this was last saved) simply keep their default position at
// the end, in the order layout.tsx's NAV array defines them.
model NavSettings {
  id        String   @id @default("singleton")
  order     String[] @default([])
  updatedAt DateTime @updatedAt
}

// --- QR Code Management ---
//
// `targetId` is a loose, untyped reference, not a Prisma relation: the
// table it points into depends on `targetType` (InventoryItem, Order for
// gemstones/certificates, Branch, or Tour), and Prisma has no polymorphic
// relation — five separate nullable FK columns would be messier than one
// resolved in code (src/lib/qr.ts). CAMPAIGN has no internal target at
// all; it's a plain external redirect.
enum QRTargetType {
  PRODUCT
  GEMSTONE
  CERTIFICATE
  BOUTIQUE
  TRAVEL_EXPERIENCE
  CAMPAIGN
}

model QRCode {
  id            String       @id @default(cuid())
  code          String       @unique
  label         String
  targetType    QRTargetType
  targetId      String?
  externalUrl   String?
  active        Boolean      @default(true)
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy Staff    @relation(fields: [createdById], references: [id])
  scans     QRScan[]

  @@index([createdById])
  @@index([targetType, targetId])
}

// Deliberately minimal — no raw IP, no precise geolocation (would need an
// external geo-IP service this deployment doesn't have); the QR's own
// label is how a boutique/campaign scan gets attributed to a place or
// promotion, not a derived location.
model QRScan {
  id        String   @id @default(cuid())
  qrCodeId  String
  scannedAt DateTime @default(now())
  ipHash    String?
  userAgent String?
  referrer  String?

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([scannedAt])
}

enum WhatsAppOrderStatus {
  PENDING
  CONVERTED
  DISMISSED
}

// An inbound message received on the business's dedicated WhatsApp Business
// Platform (Cloud API) number — captured via webhook, AI-extracted, and held
// here for a staff member to review. Nothing here ever becomes a Sale on its
// own; branch isn't known until a staff member picks one while reviewing
// (same as the existing manual "Scan an order" flow on New Sale), so this
// record isn't branch-scoped the way most of this app's data is.
model WhatsAppInboundOrder {
  id                 String              @id @default(cuid())
  fromPhone          String
  waMessageId        String              @unique
  messageType        String
  rawText            String?
  mediaPath          String?
  externalOrderNumber String?
  customerNameGuess  String?
  extractedJson      Json
  status             WhatsAppOrderStatus @default(PENDING)
  saleId             String?             @unique
  orderId            String?             @unique
  reviewedById       String?
  reviewedAt         DateTime?
  receivedAt         DateTime            @default(now())

  sale       Sale?  @relation(fields: [saleId], references: [id])
  order      Order? @relation(fields: [orderId], references: [id])
  reviewedBy Staff? @relation(fields: [reviewedById], references: [id])

  @@index([status])
  @@index([fromPhone])
}
